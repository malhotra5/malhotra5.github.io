---
import BaseLayout from './BaseLayout.astro';
import { base } from '../utils/base';

interface Props {
  title: string;
  description: string;
  date: string;
  image?: string;
  imageCaption?: string;
  readTime?: string;
  originalUrl?: string;
  tags?: string[];
}

const { title, description, date, image, imageCaption, readTime, originalUrl, tags = [] } = Astro.props;
---

<BaseLayout
  title={`${title} — Rohit Malhotra`}
  description={description}
  ogImage={image}
  currentPage="blog"
>
  <article class="pt-32 pb-16 bg-white min-h-screen">
    <div class="max-w-3xl mx-auto px-6">
      <!-- Back link -->
      <a
        href={base('/blog')}
        class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-accent transition-colors mb-8"
      >
        ← Back to Blog
      </a>

      <!-- Header -->
      <header class="mb-12">
        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 leading-tight mb-4">
          {title}
        </h1>

        <p class="text-lg text-gray-text leading-relaxed mb-4">
          {description}
        </p>

        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-400">
          <time>{date}</time>
          {readTime && (
            <>
              <span>·</span>
              <span>{readTime}</span>
            </>
          )}
          {originalUrl && (
            <>
              <span>·</span>
              <a
                href={originalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent hover:underline"
              >
                Originally on Substack ↗
              </a>
            </>
          )}
        </div>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {tags.map((tag) => (
              <span class="bg-gray-100 text-gray-600 px-2.5 py-0.5 rounded-full text-xs font-medium">
                {tag}
              </span>
            ))}
          </div>
        )}

        <div class="h-px bg-gray-200 mt-8"></div>
      </header>

      <!-- Content -->
      <div class="blog-content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .blog-content h2 {
    @apply text-2xl font-bold text-gray-800 mt-10 mb-4;
  }

  .blog-content h3 {
    @apply text-xl font-semibold text-gray-800 mt-8 mb-3;
  }

  .blog-content p {
    @apply text-gray-text text-base leading-relaxed mb-5;
  }

  .blog-content strong {
    @apply text-gray-700 font-semibold;
  }

  .blog-content a {
    @apply text-accent border-b border-dotted border-accent/40 hover:border-accent transition-colors;
  }

  .blog-content ul,
  .blog-content ol {
    @apply text-gray-text text-base leading-relaxed mb-5 pl-6;
  }

  .blog-content ul {
    @apply list-disc;
  }

  .blog-content ol {
    @apply list-decimal;
  }

  .blog-content li {
    @apply mb-2;
  }

  .blog-content blockquote {
    @apply border-l-4 border-accent/30 pl-4 my-6 italic text-gray-500;
  }

  .blog-content figure {
    @apply my-8;
  }

  .blog-content img {
    @apply rounded-lg w-full;
  }

  .blog-content figcaption {
    @apply text-sm text-gray-400 text-center mt-3 italic;
  }

  .blog-content hr {
    @apply border-gray-200 my-8;
  }
</style>
