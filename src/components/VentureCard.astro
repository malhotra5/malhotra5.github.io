---
interface Props {
  title: string;
  role: string;
  image: string;
  description: string;
}

const { title, role, image, description } = Astro.props;
---

<div class="flex flex-col">
  <div class="card-hover card-no-hover" style="height: 500px">
    <img src={image} alt={title} loading="lazy" />
    <div class="card-content">
      <h4>{title}</h4>
      <p>{role}</p>
    </div>
  </div>
  <p class="text-gray-text dark:text-gray-300 text-sm leading-relaxed mt-4 text-left">
    <slot />
  </p>
</div>
