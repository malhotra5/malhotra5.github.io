---
interface Props {
  title: string;
  date: string;
  author?: string;
  organization?: string;
}

const { title, date, author = 'Rohit Malhotra', organization = "Rohit Malhotra's Blog" } = Astro.props;

// Parse the date string (e.g. "Sep 24, 2025")
const parsed = new Date(date);
const year = parsed.getFullYear();
const month = parsed.toLocaleString('en-US', { month: 'short' });
const day = parsed.getDate();

// Build citation key: lowercased author last-first, year, "blog"
const nameParts = author.split(' ');
const citeKey = (nameParts[nameParts.length - 1] + nameParts[0]).toLowerCase() + year + 'blog';

// Current page URL
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Today's date for urldate
const today = new Date();
const urlDate = today.toISOString().split('T')[0];

const citation = `@online{${citeKey},
  author = {${author}},
  title = {${title}},
  year = {${year}},
  month = {${month}},
  day = {${day}},
  url = {${pageUrl}},
  urldate = {${urlDate}},
  note = {Blog post},
  organization = {${organization}}
}`;
---

<section class="citation-block mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
  <div class="flex items-start justify-between">
    <details class="citation-details flex-1">
      <summary class="cursor-pointer select-none inline-flex items-center gap-1.5">
        <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Citation</h2>
        <svg class="citation-chevron w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6" />
        </svg>
      </summary>

      <div class="mt-3">
        <pre class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 text-xs text-gray-700 dark:text-gray-300 overflow-x-auto font-mono leading-relaxed whitespace-pre">{citation}</pre>
      </div>
    </details>

    <button
      class="copy-btn p-1.5 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors"
      data-citation={citation}
      aria-label="Copy citation"
      title="Copy citation"
    >
      <svg class="copy-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <svg class="check-icon w-5 h-5 hidden text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </button>
  </div>
</section>

<style>
  .citation-details summary {
    list-style: none;
  }

  .citation-details summary::-webkit-details-marker {
    display: none;
  }

  .citation-details summary h2 {
    margin: 0 !important;
  }

  .citation-details[open] .citation-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const citation = btn.getAttribute('data-citation') || '';
      await navigator.clipboard.writeText(citation);

      const copyIcon = btn.querySelector('.copy-icon') as HTMLElement;
      const checkIcon = btn.querySelector('.check-icon') as HTMLElement;
      if (copyIcon && checkIcon) {
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      }
    });
  });
</script>
