---
interface Props {
  title: string;
  date: string;
  author?: string;
  organization?: string;
}

const { title, date, author = 'Rohit Malhotra', organization = "Rohit Malhotra's Blog" } = Astro.props;

// Parse the date string (e.g. "Sep 24, 2025")
const parsed = new Date(date);
const year = parsed.getFullYear();
const month = parsed.toLocaleString('en-US', { month: 'short' });
const day = parsed.getDate();

// Build citation key: lowercased author last-first, year, "blog"
const nameParts = author.split(' ');
const citeKey = (nameParts[nameParts.length - 1] + nameParts[0]).toLowerCase() + year + 'blog';

// Current page URL
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Today's date for urldate
const today = new Date();
const urlDate = today.toISOString().split('T')[0];

const citation = `@online{${citeKey},
  author = {${author}},
  title = {${title}},
  year = {${year}},
  month = {${month}},
  day = {${day}},
  url = {${pageUrl}},
  urldate = {${urlDate}},
  note = {Blog post},
  organization = {${organization}}
}`;
---

<section class="citation-block mt-12 pt-8 border-t border-gray-200">
  <div class="flex items-center justify-between mb-0">
    <h2 class="text-lg font-semibold text-gray-800 !mt-0 !mb-0">Citation</h2>
  </div>

  <details class="citation-details mt-3">
    <summary class="cursor-pointer text-sm text-accent hover:text-accent/80 transition-colors select-none flex items-center gap-1.5">
      <svg class="citation-chevron w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      Show BibTeX
    </summary>

    <div class="relative mt-3">
      <button
        class="copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-gray-100 hover:bg-gray-200 text-gray-500 hover:text-gray-700 transition-colors"
        data-citation={citation}
        aria-label="Copy citation"
        title="Copy citation"
      >
        <svg class="copy-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg class="check-icon w-4 h-4 hidden text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </button>

      <pre class="bg-gray-50 border border-gray-200 rounded-lg p-4 pr-12 text-xs text-gray-700 overflow-x-auto font-mono leading-relaxed whitespace-pre">{citation}</pre>
    </div>
  </details>
</section>

<style>
  .citation-block h2 {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .citation-details summary {
    list-style: none;
  }

  .citation-details summary::-webkit-details-marker {
    display: none;
  }

  .citation-details[open] .citation-chevron {
    transform: rotate(90deg);
  }
</style>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const citation = btn.getAttribute('data-citation') || '';
      await navigator.clipboard.writeText(citation);

      const copyIcon = btn.querySelector('.copy-icon') as HTMLElement;
      const checkIcon = btn.querySelector('.check-icon') as HTMLElement;
      if (copyIcon && checkIcon) {
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      }
    });
  });
</script>
