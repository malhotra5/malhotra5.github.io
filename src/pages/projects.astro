---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Modal from '../components/Modal.astro';
import { base } from '../utils/base';

const projects = [
  {
    id: 'flight',
    title: 'Flight Simulator',
    description: 'A flight simulator made from scratch, exploring the fundamental concepts of creating 3D graphics.',
    image: base('/img/flight2.gif'),
    tags: ['Processing'],
    height: '450px',
  },
  {
    id: 'citypop',
    title: 'Japanese City Pop Data Analysis',
    description: 'Data analysis and research on Japanese City Pop via webscraping, text mining, and text analysis.',
    image: base('/img/citypop.png'),
    tags: ['Python'],
    height: '310px',
  },
  {
    id: 'nav',
    title: 'Navigation for the Blind',
    description: 'Navigation system that uses image processing to determine best course of direction to walk in.',
    image: base('/img/sem2.png'),
    tags: ['Python'],
    height: '400px',
  },
  {
    id: 'mimer',
    title: 'Mimer: Mimicking Humanoid Robot',
    description: 'A humanoid robot that uses computer vision to mimic the movements of a human in front of it.',
    image: base('/img/rob.png'),
    tags: ['Python', 'Arduino'],
    height: '450px',
  },
  {
    id: 'web',
    title: 'Personal Website',
    description: 'My personal portfolio website built from scratch.',
    image: base('/img/web.png'),
    tags: ['HTML', 'CSS', 'JS'],
    height: '400px',
  },
  {
    id: 'manim',
    title: 'Manim Tutorial',
    description: 'A tutorial series on creating mathematical animations using Manim.',
    image: base('/img/manim.gif'),
    tags: ['Python'],
    height: '310px',
  },
  {
    id: 'cart',
    title: 'OpenAI Cartpole',
    description: 'Reinforcement learning agent solving the classic CartPole balancing problem.',
    image: base('/img/cart.gif'),
    tags: ['Python', 'OpenAI'],
    height: '310px',
  },
  {
    id: 'gpt',
    title: 'Spontaneous Response via GPT3.5',
    description: 'Spontaneous response to dynamic environments via GPT3.5.',
    image: base('/img/gpt.png'),
    tags: ['Python', 'GPT'],
    height: '450px',
  },
  {
    id: 'awap',
    title: 'Terraforming Bot',
    description: 'An autonomous terraforming bot for competitive programming challenges.',
    image: base('/img/awap.gif'),
    tags: ['Python'],
    height: '310px',
  },
  {
    id: 'yout',
    title: 'YouTube Educational Series',
    description: 'Educational video series covering CS and ML topics.',
    image: base('/img/yout.png'),
    tags: ['Education'],
    height: '400px',
  },
];

---

<BaseLayout title="Projects — Rohit Malhotra" currentPage="projects" darkBg={true}>
  <!-- Projects Section -->
  <section class="pt-32 pb-24 bg-dark min-h-screen">
    <div class="max-w-5xl mx-auto px-6">
      <SectionHeading title="Projects" light={true} />

      <div class="columns-1 lg:columns-2 gap-6">
        {projects.map((project) => (
          <div class="mb-6 break-inside-avoid cursor-pointer" data-open-modal={project.id}>
            <ProjectCard
              title={project.title}
              description={project.description}
              image={project.image}
              tags={project.tags}
              height={project.height}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Modals -->
  {projects.map((project) => (
    <Modal id={`modal-${project.id}`} title={project.title} image={project.image} />
  ))}
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Open modal
    document.querySelectorAll('[data-open-modal]').forEach(function (el) {
      el.addEventListener('click', function () {
        var id = 'modal-' + el.getAttribute('data-open-modal');
        var modal = document.getElementById(id);
        if (modal) modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    // Close modal
    document.querySelectorAll('[data-modal-close]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var overlay = btn.closest('.modal-overlay');
        if (overlay) overlay.classList.remove('active');
        document.body.style.overflow = '';
      });
    });

    // Close on overlay click
    document.querySelectorAll('.modal-overlay').forEach(function (overlay) {
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) {
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay.active').forEach(function (m) {
          m.classList.remove('active');
        });
        document.body.style.overflow = '';
      }
    });
  });
</script>
