---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const publications = [
  {
    title: 'The OpenHands Software Agent SDK: A Composable and Extensible Foundation for Production Agents',
    authors: ['Xingyao Wang', 'Simon Rosenberg', 'Juan Michelini', 'Calvin Smith', 'Hoang Tran', 'Engel Nyst', 'Rohit Malhotra', 'Xuhui Zhou', 'Valerie Chen', 'Robert Brennan', 'Graham Neubig'],
    venue: 'Proceedings of the Eighth Conference on Machine Learning and Systems (MLSys)',
    location: 'Bellevue, WA, USA (Oral)',
    date: 'Nov 2026',
    url: 'https://arxiv.org/abs/2511.03690',
  },
  {
    title: 'How can we assess human-agent interactions? Case studies in software agent design',
    authors: ['Valerie Chen', 'Rohit Malhotra', 'Xingyao Wang', 'Juan Michelini', 'Xuhui Zhou', 'Aditya Bharat Soni', 'Hoang H. Tran', 'Calvin Smith', 'Ameet Talwalkar', 'Graham Neubig'],
    venue: 'International Conference on Machine Learning (ICML)',
    location: 'Seoul, South Korea',
    date: 'July 2026',
    url: 'https://arxiv.org/abs/2510.09801',
  },
  {
    title: 'VHABench: Benchmarking Underspecified User Intents for Tool Augmented LLMs',
    authors: ['Rohit Malhotra'],
    venue: '',
    location: '',
    date: '',
    url: 'https://www.researchgate.net/publication/383231851_VHABench_Benchmarking_Underspecified_User_Intents_for_Tool_Augmented_LLMs',
  },
  {
    title: 'CluRag: Improving Zero-Shot RAG systems using clustering',
    authors: ['Rohit Malhotra'],
    venue: '',
    location: '',
    date: '',
    url: 'https://www.researchgate.net/publication/383231819_Finding_the_Best_Zero-Shot_RAG_Systems_for_Multi-Group_Topics',
  },
];

const ME = 'Rohit Malhotra';
---

<BaseLayout title="Research — Rohit Malhotra" currentPage="research">
  <section class="pt-32 pb-16 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-6">
      <SectionHeading title="Research" />

      <p class="text-gray-text text-lg md:text-xl text-center leading-relaxed mb-16">
        I'm attempting to specialize in NLP. I'm interested in getting the most
        out of LLMs without changing their weights (i.e Agents).
      </p>

      <h3 class="text-3xl font-bold text-gray-800 text-center mb-12">Publications</h3>

      <div class="flex flex-col gap-6">
        {publications.map((paper) => (
          <a
            href={paper.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-6 rounded-lg border-2 border-gray-200
                   hover:border-accent hover:shadow-md transition-all duration-300 group"
          >
            <h4 class="text-lg font-semibold text-gray-800 group-hover:text-accent transition-colors">
              {paper.title}
              <span class="text-xs text-gray-400 ml-1">↗</span>
            </h4>

            <p class="text-sm text-gray-500 mt-2 leading-relaxed">
              {paper.authors.map((author, i) => (
                <>
                  {author === ME ? (
                    <span class="underline underline-offset-2 font-medium text-gray-700">{author}</span>
                  ) : (
                    <span>{author}</span>
                  )}
                  {i < paper.authors.length - 1 && ', '}
                </>
              ))}
            </p>

            {paper.venue && (
              <p class="text-sm text-gray-500 mt-1 italic">
                {paper.venue}.{paper.location && ` ${paper.location}.`}{paper.date && ` ${paper.date}.`}
              </p>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
